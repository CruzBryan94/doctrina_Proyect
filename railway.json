{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "requiredMountPath": "/app/storage",
    "preDeployCommand": [],
    "healthcheckPath": "/login",
    "healthcheckTimeout": 120,
    "drainingSeconds": 150,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
