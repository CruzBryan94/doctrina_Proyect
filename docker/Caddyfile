{
    admin off
    auto_https off
}

:{$PORT:8080} {
    root * /app/public
    @hidden path /.env /.env/* /.git /.git/*
    respond @hidden 404
    php_fastcgi 127.0.0.1:9000 {
        # This image is intended for Railway Edge with external HTTPS only.
        # Laravel's proxy middleware remains unchanged; validate client IP separately.
        env HTTPS on
        env SERVER_PORT 443
        read_timeout 150s
        capture_stderr
    }
    file_server
}
